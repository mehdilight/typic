#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/../vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Typic dependencies are missing. Run composer install first.\n");
    exit(1);
}
require $autoload;

exit((new Typic\Console\ConsoleApplication())->run());
