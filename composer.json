{
    "name": "typic/typic",
    "description": "Modern, code-first, attribute-driven GraphQL framework for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "webonyx/graphql-php": "^15.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0 || ^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Typic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Typic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
