<?php

declare(strict_types=1);

use Typic\Application;
use Typic\Subscription\Driver\Workerman\WorkermanDriver;

$app = new Application(require __DIR__ . '/config/services.php');
$app->builder()
    ->scanDirectories([__DIR__ . '/src/GraphQL'])
    ->withDebug(getenv('APP_DEBUG') === '1')
    ->withGraphiQL(options: [
        'title' => 'Typic API',
        'initialDocument' => '{ hello(name: "world") }',
    ])
    ->withQueryLimits(maxDepth: 10, maxComplexity: 200)
    ->withMaxRequestSize(1024 * 1024)
    ->withSubscriptions(driver: new WorkermanDriver(
        host: getenv('HOST') ?: '127.0.0.1',
        port: (int) (getenv('PORT') ?: 8000),
        workerCount: (int) (getenv('WORKERS') ?: 1),
    ));

return $app;
